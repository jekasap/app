<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kettle & Crumb | Order Book</title>
    <!-- Tailwind CSS for rapid styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Channel Icons and Warnings -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6', // Teal
                            600: '#0d9488',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for a polished look */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        
        /* Smooth transitions for the allergy toggle */
        .allergy-transition {
            transition: all 0.3s ease-in-out;
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 font-sans h-screen flex overflow-hidden">

    <!-- Left Sidebar: Order Book -->
    <aside class="w-full md:w-80 bg-white border-r border-gray-200 flex flex-col h-full shadow-lg z-10 flex-shrink-0 transition-transform duration-300 absolute md:relative transform -translate-x-full md:translate-x-0" id="sidebar">
        <!-- Sidebar Header -->
        <div class="p-6 border-b border-gray-200 bg-brand-900 text-white flex justify-between items-center">
            <div>
                <h1 class="text-xl font-bold tracking-tight">Kettle & Crumb</h1>
                <p class="text-brand-100 text-sm opacity-80 mt-1">Unified Order Book</p>
            </div>
            <!-- Mobile close button -->
            <button id="close-sidebar" class="md:hidden text-white hover:text-gray-300">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        
        <!-- Search / Filter (Visual only for this prototype) -->
        <div class="p-4 border-b border-gray-100 bg-gray-50">
            <div class="relative">
                <i class="fas fa-search absolute left-3 top-3 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Search orders..." class="w-full pl-9 pr-3 py-2 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            </div>
        </div>

        <!-- Orders List -->
        <div class="flex-1 overflow-y-auto p-3 space-y-3" id="orders-list">
            <!-- Orders will be injected here by JavaScript -->
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-full relative overflow-hidden bg-gray-50">
        
        <!-- Mobile Header (Visible only on small screens) -->
        <header class="md:hidden bg-white border-b border-gray-200 p-4 flex items-center justify-between shadow-sm z-10">
            <h1 class="text-lg font-bold text-gray-800">New Order</h1>
            <button id="open-sidebar" class="text-gray-600 hover:text-brand-600 focus:outline-none">
                <i class="fas fa-bars text-xl"></i>
                <span class="ml-2 font-medium text-sm">Order Book</span>
            </button>
        </header>

        <!-- Form Container -->
        <div class="flex-1 overflow-y-auto p-4 md:p-8 w-full max-w-4xl mx-auto">
            
            <div class="mb-6 flex justify-between items-end">
                <div>
                    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Enter New Order</h2>
                    <p class="text-gray-500 mt-1">Cross-channel order entry system</p>
                </div>
                <div class="text-sm font-medium text-gray-500 bg-white px-3 py-1 rounded-full border border-gray-200 shadow-sm">
                    <i class="fas fa-user-circle text-brand-500 mr-1"></i> Aoife
                </div>
            </div>

            <form id="new-order-form" class="space-y-8 bg-white p-6 md:p-8 rounded-xl shadow-sm border border-gray-200">
                
                <!-- CRITICAL ALLERGY SECTION - MUST BE AT TOP -->
                <div id="allergy-container" class="rounded-lg border-2 border-gray-200 bg-gray-50 p-6 transition-colors duration-300">
                    <h3 class="text-lg font-bold text-gray-900 mb-4 uppercase tracking-wider flex items-center">
                        <i class="fas fa-shield-halved mr-2 text-gray-400" id="allergy-header-icon"></i> 
                        Dietary & Allergy Requirements
                    </h3>
                    
                    <div class="flex flex-col sm:flex-row gap-4 mb-4">
                        <!-- No Allergy Toggle -->
                        <label class="flex-1 cursor-pointer">
                            <input type="radio" name="hasAllergy" value="no" class="peer sr-only" checked>
                            <div class="rounded-md border-2 border-gray-200 bg-white p-4 text-center hover:bg-gray-50 peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 font-bold transition-all">
                                <i class="fas fa-check-circle mb-2 text-xl block"></i>
                                NO KNOWN ALLERGIES
                            </div>
                        </label>

                        <!-- HAS ALLERGY Toggle (CRITICAL) -->
                        <label class="flex-1 cursor-pointer">
                            <input type="radio" name="hasAllergy" value="yes" class="peer sr-only">
                            <div class="rounded-md border-2 border-gray-200 bg-white p-4 text-center hover:bg-gray-50 peer-checked:border-red-600 peer-checked:bg-red-600 peer-checked:text-white font-black peer-checked:shadow-lg transition-all animate-pulse-once">
                                <i class="fas fa-triangle-exclamation mb-2 text-xl block"></i>
                                ⚠️ ALERT: HAS ALLERGIES
                            </div>
                        </label>
                    </div>

                    <!-- Hidden by default, shown if Yes is selected -->
                    <div id="allergy-details-wrapper" class="hidden allergy-transition mt-4">
                        <label for="allergy-details" class="block text-sm font-bold text-red-700 mb-2 uppercase">Specify Allergies / Dietary Needs <span class="text-red-500">*</span></label>
                        <textarea id="allergy-details" name="allergyDetails" rows="2" 
                            class="w-full rounded-md border-2 border-red-300 bg-red-50 py-3 px-4 text-red-900 placeholder-red-300 focus:border-red-600 focus:ring-red-600 font-bold text-lg shadow-inner" 
                            placeholder="e.g., SEVERE NUT ALLERGY - EPIPEN CARRIER"></textarea>
                    </div>
                </div>

                <!-- Standard Order Details Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-gray-100">
                    
                    <!-- Customer Name -->
                    <div>
                        <label for="customer-name" class="block text-sm font-medium text-gray-700 mb-1">Customer Name <span class="text-red-500">*</span></label>
                        <input type="text" id="customer-name" name="customerName" required
                            class="w-full rounded-md border border-gray-300 py-2 px-3 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 shadow-sm"
                            placeholder="Full Name">
                    </div>

                    <!-- Date Needed -->
                    <div>
                        <label for="date-needed" class="block text-sm font-medium text-gray-700 mb-1">Date Needed <span class="text-red-500">*</span></label>
                        <input type="date" id="date-needed" name="dateNeeded" required
                            class="w-full rounded-md border border-gray-300 py-2 px-3 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 shadow-sm">
                    </div>

                    <!-- Event Type -->
                    <div>
                        <label for="event-type" class="block text-sm font-medium text-gray-700 mb-1">Event Type <span class="text-red-500">*</span></label>
                        <select id="event-type" name="eventType" required
                            class="w-full rounded-md border border-gray-300 py-2 px-3 bg-white focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 shadow-sm">
                            <option value="" disabled selected>Select event type...</option>
                            <option value="Funeral">Funeral</option>
                            <option value="Wedding">Wedding</option>
                            <option value="Corporate">Corporate Event</option>
                            <option value="Party">Private Party</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- Source Channel -->
                    <div>
                        <label for="source-channel" class="block text-sm font-medium text-gray-700 mb-1">Source Channel <span class="text-red-500">*</span></label>
                        <select id="source-channel" name="sourceChannel" required
                            class="w-full rounded-md border border-gray-300 py-2 px-3 bg-white focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 shadow-sm">
                            <option value="" disabled selected>How did they order?</option>
                            <option value="Phone">Phone</option>
                            <option value="Email">Email</option>
                            <option value="Instagram">Instagram</option>
                            <option value="WhatsApp">WhatsApp</option>
                            <option value="In-Person">In-Person</option>
                        </select>
                    </div>
                </div>

                <!-- Order Details -->
                <div class="pt-2">
                    <label for="order-details" class="block text-sm font-medium text-gray-700 mb-1">Order Details <span class="text-red-500">*</span></label>
                    <textarea id="order-details" name="orderDetails" rows="5" required
                        class="w-full rounded-md border border-gray-300 py-2 px-3 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 shadow-sm"
                        placeholder="List items, quantities, and specific requests here..."></textarea>
                </div>

                <!-- Action Area -->
                <div class="pt-6 border-t border-gray-100 flex items-center justify-between">
                    <button type="button" id="clear-form-btn" class="text-gray-500 hover:text-gray-700 text-sm font-medium transition-colors">
                        Cancel & Clear
                    </button>
                    <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white font-bold py-3 px-8 rounded-md shadow-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors transform active:scale-95 flex items-center">
                        <i class="fas fa-save mr-2"></i> Save Order to Book
                    </button>
                </div>

            </form>
        </div>
        
        <!-- Toast Notification Container -->
        <div id="toast-container" class="absolute bottom-4 right-4 flex flex-col gap-2 z-50"></div>
    </main>

    <script>
        // --- State Management ---
        
        // Initial test case requested by the prompt
        let orders = [
            {
                id: Date.now().toString(),
                customerName: "Jane Doe",
                dateNeeded: new Date(Date.now() + 86400000 * 3).toISOString().split('T')[0], // +3 days
                eventType: "Funeral",
                sourceChannel: "Phone",
                hasAllergy: true,
                allergyDetails: "SEVERE NUT ALLERGY",
                orderDetails: "Assorted sandwich platters and tea",
                timestamp: new Date().toISOString()
            }
        ];

        // --- DOM Elements ---
        const form = document.getElementById('new-order-form');
        const allergyRadios = document.getElementsByName('hasAllergy');
        const allergyContainer = document.getElementById('allergy-container');
        const allergyHeaderIcon = document.getElementById('allergy-header-icon');
        const allergyDetailsWrapper = document.getElementById('allergy-details-wrapper');
        const allergyDetailsInput = document.getElementById('allergy-details');
        const ordersListElement = document.getElementById('orders-list');
        const clearFormBtn = document.getElementById('clear-form-btn');
        
        // Mobile Sidebar Toggles
        const sidebar = document.getElementById('sidebar');
        const openSidebarBtn = document.getElementById('open-sidebar');
        const closeSidebarBtn = document.getElementById('close-sidebar');

        // --- Helper Functions ---

        // Map channels to FontAwesome icons
        function getChannelIcon(channel) {
            switch(channel) {
                case 'Phone': return '<i class="fas fa-phone text-blue-500"></i>';
                case 'Email': return '<i class="fas fa-envelope text-gray-500"></i>';
                case 'Instagram': return '<i class="fab fa-instagram text-pink-500"></i>';
                case 'WhatsApp': return '<i class="fab fa-whatsapp text-green-500"></i>';
                case 'In-Person': return '<i class="fas fa-user-friends text-brand-600"></i>';
                default: return '<i class="fas fa-inbox text-gray-400"></i>';
            }
        }

        // Map events to styling classes
        function getEventBadge(eventType) {
            let colors = "bg-gray-100 text-gray-800";
            switch(eventType) {
                case 'Funeral': colors = "bg-slate-800 text-slate-100"; break;
                case 'Wedding': colors = "bg-rose-100 text-rose-800"; break;
                case 'Corporate': colors = "bg-blue-100 text-blue-800"; break;
                case 'Party': colors = "bg-purple-100 text-purple-800"; break;
            }
            return `<span class="px-2 py-1 rounded text-xs font-semibold ${colors}">${eventType}</span>`;
        }

        // Format Date
        function formatDate(dateString) {
            const options = { weekday: 'short', month: 'short', day: 'numeric' };
            return new Date(dateString).toLocaleDateString(undefined, options);
        }

        // Show toast notification
        function showToast(message, isError = false) {
            const toastContainer = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgColor = isError ? 'bg-red-600' : 'bg-gray-800';
            toast.className = `${bgColor} text-white px-4 py-3 rounded shadow-lg flex items-center transition-opacity duration-300 opacity-0 transform translate-y-2`;
            toast.innerHTML = `
                <i class="fas ${isError ? 'fa-exclamation-circle' : 'fa-check-circle'} mr-2"></i>
                <span>${message}</span>
            `;
            toastContainer.appendChild(toast);
            
            // Trigger animation
            requestAnimationFrame(() => {
                toast.classList.remove('opacity-0', 'translate-y-2');
            });

            // Remove after 3 seconds
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // --- Core Application Logic ---

        // Handle Allergy UI Toggle
        function handleAllergyToggle() {
            const hasAllergy = document.querySelector('input[name="hasAllergy"]:checked').value === 'yes';
            
            if (hasAllergy) {
                // Show details, make container red and highly visible
                allergyDetailsWrapper.classList.remove('hidden');
                allergyContainer.classList.remove('border-gray-200', 'bg-gray-50');
                allergyContainer.classList.add('border-red-500', 'bg-red-50');
                allergyHeaderIcon.className = "fas fa-triangle-exclamation mr-2 text-red-600 animate-pulse";
                allergyDetailsInput.required = true;
                // Auto-focus the critical field
                allergyDetailsInput.focus();
            } else {
                // Hide details, revert container styling
                allergyDetailsWrapper.classList.add('hidden');
                allergyContainer.classList.remove('border-red-500', 'bg-red-50');
                allergyContainer.classList.add('border-gray-200', 'bg-gray-50');
                allergyHeaderIcon.className = "fas fa-shield-halved mr-2 text-gray-400";
                allergyDetailsInput.required = false;
                allergyDetailsInput.value = ''; // Clear existing data if they switch to No
            }
        }

        // Attach listeners to radio buttons
        allergyRadios.forEach(radio => {
            radio.addEventListener('change', handleAllergyToggle);
        });

        // Render Orders List in Sidebar
        function renderOrders() {
            ordersListElement.innerHTML = ''; // Clear list
            
            if (orders.length === 0) {
                ordersListElement.innerHTML = `<p class="text-gray-500 text-sm text-center py-4">No orders in the book yet.</p>`;
                return;
            }

            // Sort by date needed (closest first)
            const sortedOrders = [...orders].sort((a, b) => new Date(a.dateNeeded) - new Date(b.dateNeeded));

            sortedOrders.forEach(order => {
                const card = document.createElement('div');
                
                // CRITICAL: Highlight orders with allergies in the sidebar
                const allergyStyles = order.hasAllergy 
                    ? 'border-red-500 bg-red-50 shadow-md transform hover:-translate-y-1 transition-transform' 
                    : 'border-gray-200 bg-white hover:bg-gray-50 border-l-4 border-l-brand-500';
                
                card.className = `p-4 rounded-lg border ${allergyStyles} cursor-pointer relative`;
                
                // Construct card HTML
                let cardHTML = `
                    <div class="flex justify-between items-start mb-2">
                        <h4 class="font-bold text-gray-900 truncate pr-6">${order.customerName}</h4>
                        ${getEventBadge(order.eventType)}
                    </div>
                    
                    <div class="flex items-center text-sm text-gray-600 mb-2">
                        <i class="far fa-calendar-alt mr-2"></i> ${formatDate(order.dateNeeded)}
                        <span class="mx-2">&bull;</span>
                        <span title="${order.sourceChannel}">${getChannelIcon(order.sourceChannel)}</span>
                    </div>
                `;

                // If allergy exists, inject the prominent warning
                if (order.hasAllergy) {
                    cardHTML += `
                        <div class="mt-3 bg-red-600 text-white text-xs font-bold px-2 py-1.5 rounded flex items-start shadow-sm">
                            <i class="fas fa-exclamation-triangle mt-0.5 mr-1.5"></i>
                            <span class="truncate uppercase leading-tight">${order.allergyDetails}</span>
                        </div>
                    `;
                } else {
                    // Preview normal order details if no allergy takes up space
                    cardHTML += `
                        <p class="text-xs text-gray-500 truncate mt-2 border-t border-gray-100 pt-2">
                            ${order.orderDetails}
                        </p>
                    `;
                }

                card.innerHTML = cardHTML;
                
                // Optional: Add click listener to view order details (mock behavior for now)
                card.addEventListener('click', () => {
                   // In a full app, this would populate the form or a modal with the order data
                   console.log("Clicked order:", order.id);
                });

                ordersListElement.appendChild(card);
            });
        }

        // Handle Form Submission
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            // Extract data
            const formData = new FormData(form);
            const hasAllergy = formData.get('hasAllergy') === 'yes';
            
            // Custom Validation: If allergy is Yes, details must not be empty (fallback if required attribute fails)
            if (hasAllergy && !formData.get('allergyDetails').trim()) {
                showToast("Please specify the allergy details.", true);
                allergyDetailsInput.focus();
                return;
            }

            // Create new order object
            const newOrder = {
                id: Date.now().toString(),
                customerName: formData.get('customerName'),
                dateNeeded: formData.get('dateNeeded'),
                eventType: formData.get('eventType'),
                sourceChannel: formData.get('sourceChannel'),
                hasAllergy: hasAllergy,
                allergyDetails: hasAllergy ? formData.get('allergyDetails') : null,
                orderDetails: formData.get('orderDetails'),
                timestamp: new Date().toISOString()
            };

            // Add to state and re-render
            orders.unshift(newOrder); // Add to beginning
            renderOrders();

            // Success feedback
            showToast("Order saved to book successfully!");
            
            // Reset form
            resetForm();
            
            // On mobile, automatically open sidebar to show the new order
            if(window.innerWidth < 768) {
                sidebar.classList.remove('-translate-x-full');
            }
        });

        // Reset Form Helper
        function resetForm() {
            form.reset();
            // Programmatically check the 'no' allergy radio to trigger the UI reset
            document.querySelector('input[name="hasAllergy"][value="no"]').checked = true;
            handleAllergyToggle(); // Reset the UI coloring
        }

        clearFormBtn.addEventListener('click', resetForm);

        // Mobile Sidebar Controls
        openSidebarBtn.addEventListener('click', () => {
            sidebar.classList.remove('-translate-x-full');
        });
        
        closeSidebarBtn.addEventListener('click', () => {
            sidebar.classList.add('-translate-x-full');
        });

        // Initialize App
        document.addEventListener('DOMContentLoaded', () => {
            renderOrders();
            handleAllergyToggle(); // Set initial styling based on default radio selection
        });

    </script>
</body>
</html>
